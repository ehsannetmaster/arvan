# Copy to terraform.tfvars and fill in your values. Do NOT commit terraform.tfvars.

proxmox_endpoint  = "https://YOUR_PROXMOX_HOST:8006/"
proxmox_api_token = "automation@pve!mytoken=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

target_node = "pve"         # your node name (see `pvecm nodes` or top-left in the UI)
template_id = 9000
storage     = "storage1"
bridge      = "vmbr231"

ci_user = "ubuntu"
ssh_public_keys = [
  "ssh-ed25519 AAAA... you@host",
]

# Override the defaults if needed:
# gateway    = "100.64.231.254"
# netmask    = 24
# dns_server = "8.8.8.8"
