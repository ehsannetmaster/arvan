# Deny everything at the repo root, then re-include only the GitOps directories.
/*
!/.gitignore
!/README.md
!/.github/
!/apps/
!/bootstrap/
!/monitoring/
!/postgres/
!/ip-country-api/
!/kubespray/
!/terraform/

# ...but never commit Terraform secrets, state, plans, or local cache.
/terraform/*.tfvars
/terraform/*.tfstate*
/terraform/*.tfplan
/terraform/.terraform/
/terraform/crash*.log
