# Ignore everything at the repo root by default...
/*

# ...then re-include only the GitOps directories (and this file).
# Once a directory is un-ignored, all files inside it are tracked.
!/.gitignore
!/.github/
!/apps/
!/bootstrap/
!/monitoring/
!/postgres/
!/ip-country-api/
!/kubespray/
!/terraform/
# ...but never commit Terraform secrets, state, or local cache.
/terraform/terraform.tfvars
/terraform/*.auto.tfvars
/terraform/*.tfstate
/terraform/*.tfstate.*
/terraform/.terraform/
/terraform/*.tfplan
/terraform/crash.log
/terraform/crash.*.log